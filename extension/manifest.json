{
  "manifest_version": 3,
  "name": "Memoir Scout",
  "version": "1.2",
  "description": "현재 페이지를 Memoir AI 메모리로 저장합니다",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "현재 페이지를 Memoir에 저장"
    }
  },
  "host_permissions": [
    "https://memoir-ai-backend.fly.dev/*",
    "https://otzqnucgfrlbqyyhksgo.supabase.co/*",
    "http://localhost:8000/*"
  ]
}
