{
  "manifest_version": 3,
  "name": "Memoir Scout",
  "version": "1.0",
  "description": "Save current page to Memoir AI",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://memoir-ai-backend.fly.dev/*",
    "http://localhost:8000/*"
  ]
}
